{
  "type": "object",
  "required": ["verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "verdict": {"enum": ["APPROVED", "APPROVED_WITH_NOTES", "REJECTED", "BLOCKED"]},
    "summary": {"type": "string", "maxLength": 12000},
    "findings": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "title", "evidence", "recommendation"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "severity": {"enum": ["Crítico", "Alto", "Medio", "Leve", "Informativo"]},
          "file": {"type": "string", "minLength": 1, "maxLength": 500},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 12000},
          "recommendation": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
